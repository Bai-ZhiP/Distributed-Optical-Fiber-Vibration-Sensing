# FL9613 FMC-LPC -> AX7350B pin map.
# The mapping is derived from the AX7350B/FL9613 connector tables.  ADC
# differential pairs are wired to the AD9613 DCO (data clock) and LVDS data
# lanes; the carrier 50 MHz oscillator remains sys_clk.

set_property PACKAGE_PIN AC14 [get_ports adc1_clk_p]
set_property PACKAGE_PIN AD14 [get_ports adc1_clk_n]
set_property PACKAGE_PIN AD23 [get_ports adc2_clk_p]
set_property PACKAGE_PIN AD24 [get_ports adc2_clk_n]
set_property IOSTANDARD LVDS_25 [get_ports adc1_clk_p]
set_property IOSTANDARD LVDS_25 [get_ports adc1_clk_n]
set_property IOSTANDARD LVDS_25 [get_ports adc2_clk_p]
set_property IOSTANDARD LVDS_25 [get_ports adc2_clk_n]
set_property DIFF_TERM TRUE [get_ports adc1_clk_p]
set_property DIFF_TERM TRUE [get_ports adc2_clk_p]

set_property PACKAGE_PIN Y10  [get_ports {adc1_data_p[0]}]
set_property PACKAGE_PIN AA10 [get_ports {adc1_data_n[0]}]
set_property PACKAGE_PIN AE11 [get_ports {adc1_data_p[1]}]
set_property PACKAGE_PIN AF10 [get_ports {adc1_data_n[1]}]
set_property PACKAGE_PIN AC12 [get_ports {adc1_data_p[2]}]
set_property PACKAGE_PIN AD11 [get_ports {adc1_data_n[2]}]
set_property PACKAGE_PIN AE10 [get_ports {adc1_data_p[3]}]
set_property PACKAGE_PIN AD10 [get_ports {adc1_data_n[3]}]
set_property PACKAGE_PIN AB12 [get_ports {adc1_data_p[4]}]
set_property PACKAGE_PIN AC11 [get_ports {adc1_data_n[4]}]
set_property PACKAGE_PIN Y12  [get_ports {adc1_data_p[5]}]
set_property PACKAGE_PIN Y11  [get_ports {adc1_data_n[5]}]
set_property PACKAGE_PIN AB11 [get_ports {adc1_data_p[6]}]
set_property PACKAGE_PIN AB10 [get_ports {adc1_data_n[6]}]
set_property PACKAGE_PIN AE13 [get_ports {adc1_data_p[7]}]
set_property PACKAGE_PIN AF13 [get_ports {adc1_data_n[7]}]
set_property PACKAGE_PIN W13  [get_ports {adc1_data_p[8]}]
set_property PACKAGE_PIN Y13  [get_ports {adc1_data_n[8]}]
set_property PACKAGE_PIN AE12 [get_ports {adc1_data_p[9]}]
set_property PACKAGE_PIN AF12 [get_ports {adc1_data_n[9]}]
set_property PACKAGE_PIN AD16 [get_ports {adc1_data_p[10]}]
set_property PACKAGE_PIN AD15 [get_ports {adc1_data_n[10]}]
set_property PACKAGE_PIN AF15 [get_ports {adc1_data_p[11]}]
set_property PACKAGE_PIN AF14 [get_ports {adc1_data_n[11]}]

set_property PACKAGE_PIN AF19 [get_ports {adc2_data_p[0]}]
set_property PACKAGE_PIN AF20 [get_ports {adc2_data_n[0]}]
set_property PACKAGE_PIN AE20 [get_ports {adc2_data_p[1]}]
set_property PACKAGE_PIN AE21 [get_ports {adc2_data_n[1]}]
set_property PACKAGE_PIN AC21 [get_ports {adc2_data_p[2]}]
set_property PACKAGE_PIN AC22 [get_ports {adc2_data_n[2]}]
set_property PACKAGE_PIN AD18 [get_ports {adc2_data_p[3]}]
set_property PACKAGE_PIN AD19 [get_ports {adc2_data_n[3]}]
set_property PACKAGE_PIN AA20 [get_ports {adc2_data_p[4]}]
set_property PACKAGE_PIN AB20 [get_ports {adc2_data_n[4]}]
set_property PACKAGE_PIN AE22 [get_ports {adc2_data_p[5]}]
set_property PACKAGE_PIN AF22 [get_ports {adc2_data_n[5]}]
set_property PACKAGE_PIN AB21 [get_ports {adc2_data_p[6]}]
set_property PACKAGE_PIN AB22 [get_ports {adc2_data_n[6]}]
set_property PACKAGE_PIN AE23 [get_ports {adc2_data_p[7]}]
set_property PACKAGE_PIN AF23 [get_ports {adc2_data_n[7]}]
set_property PACKAGE_PIN AF24 [get_ports {adc2_data_p[8]}]
set_property PACKAGE_PIN AF25 [get_ports {adc2_data_n[8]}]
set_property PACKAGE_PIN AA22 [get_ports {adc2_data_p[9]}]
set_property PACKAGE_PIN AA23 [get_ports {adc2_data_n[9]}]
set_property PACKAGE_PIN AE25 [get_ports {adc2_data_p[10]}]
set_property PACKAGE_PIN AE26 [get_ports {adc2_data_n[10]}]
set_property PACKAGE_PIN AD25 [get_ports {adc2_data_p[11]}]
set_property PACKAGE_PIN AD26 [get_ports {adc2_data_n[11]}]
set_property IOSTANDARD LVDS_25 [get_ports {adc1_data_p[*]}]
set_property IOSTANDARD LVDS_25 [get_ports {adc1_data_n[*]}]
set_property IOSTANDARD LVDS_25 [get_ports {adc2_data_p[*]}]
set_property IOSTANDARD LVDS_25 [get_ports {adc2_data_n[*]}]
set_property DIFF_TERM TRUE [get_ports {adc1_data_p[*]}]
set_property DIFF_TERM TRUE [get_ports {adc2_data_p[*]}]

set_property PACKAGE_PIN AE16 [get_ports adc1_spi_ce]
set_property PACKAGE_PIN AD21 [get_ports adc1_spi_sclk]
set_property PACKAGE_PIN AE15 [get_ports adc1_spi_io]
set_property PACKAGE_PIN AB17 [get_ports adc2_spi_ce]
set_property PACKAGE_PIN AF18 [get_ports adc2_spi_sclk]
set_property PACKAGE_PIN AE18 [get_ports adc2_spi_io]
set_property IOSTANDARD LVCMOS25 [get_ports {adc1_spi_ce adc1_spi_sclk adc1_spi_io adc2_spi_ce adc2_spi_sclk adc2_spi_io}]

set_property PACKAGE_PIN AC26 [get_ports clk_spi_ce]
set_property PACKAGE_PIN AB26 [get_ports clk_spi_sclk]
set_property PACKAGE_PIN AE17 [get_ports clk_spi_sdio]
set_property PACKAGE_PIN AB25 [get_ports clk_spi_sdo]
set_property PACKAGE_PIN AA25 [get_ports clk_resetn]
set_property PACKAGE_PIN AB16 [get_ports clk_sync]
set_property PACKAGE_PIN AF17 [get_ports ad_sync]
set_property IOSTANDARD LVCMOS25 [get_ports {clk_spi_ce clk_spi_sclk clk_spi_sdio clk_spi_sdo clk_resetn clk_sync ad_sync}]

# sys_clk is the AX7350B 50 MHz PL oscillator (J14), used for SPI setup and
# PS/AXI control.  The AD9613 sample clock is the FMC DCO above.
set_property PACKAGE_PIN J14 [get_ports sys_clk]
set_property IOSTANDARD LVCMOS18 [get_ports sys_clk]

# TRIG_IN: FL9613 G2 -> AX7350B FMC_CLK1_P -> AD20.
# The module translates the external 3.3 V input to 2.5 V VADJ.
set_property PACKAGE_PIN AD20 [get_ports trig_in]
set_property IOSTANDARD LVCMOS25 [get_ports trig_in]
set_false_path -from [get_ports trig_in]
# Internal AD9518: 250 MHz; root sys_clk is defined in adc_clock_cdc.xdc.
create_clock -name adc1_dco_250m -period 4.000 [get_ports adc1_clk_p]
create_clock -name adc2_dco_250m -period 4.000 [get_ports adc2_clk_p]
